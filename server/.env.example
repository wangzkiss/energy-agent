# ---- 模型代理 ----
# anthropic：追加 /v1/messages；openai：追加 /v1/chat/completions
# 设置页「模型」保存后会覆盖这里的默认值（server/model_config.json）
LLM_BASE_URL=http://127.0.0.1:18786/llmproxy/anthropic
LLM_PROTOCOL=anthropic
LLM_API_KEY=replace-with-appkey
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=90

# ---- BFF 访问令牌 ----
# 前端默认使用 energy-demo-token；生产环境请换成 SSO/网关鉴权
BFF_TOKEN=energy-demo-token
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# ---- 数据源 ----
# archery：通过 /archery 技能只读查询 Doris/MySQL（默认，不建立数据库直连）
# mock：仅离线演示
DATA_PROVIDER=archery

# 是否允许按问题里的租户名跨库查询；按需求默认 true。
# 生产仍应由网关注入租户身份（X-Tenant-Id/SSO），不要直接开放给普通租户用户。
ALLOW_TENANT_QUERY=true

# /archery 技能；数据库密码只保存在技能的 archery_config.txt
ARCHERY_INSTANCE=数智能效saas现网-doris
ARCHERY_HELPER_DIR=C:\Users\2025\.dsh\skills\archery

# 逻辑库名/租户过滤（用于生成 SQL，不代表直连地址）
DORIS_DB=nwdy_dm
DORIS_TENANT_ID=1026
DORIS_PROJECT_ID=1
# 租户与库的完整映射见 server/tenants.py（同步自 eo_tenant_data_sources）
DORIS_ENERGY_TYPE=electric

# 线上 MySQL 业务库：同一个 Archery 实例，仅切换 db_name；每个租户一个库。
MYSQL_ENABLED=true
MYSQL_ARCHERY_INSTANCE=数智能效saas现网
MYSQL_DB=nwdy

# ---- 自主调查（tool loop）----
# 固定模板覆盖不了时，让模型自己查表结构/口径/代码并跑只读 SQL。
# 设为 false 可退回“只走固定模板”的保守模式。
AGENT_TOOL_LOOP=true
# 单次调查最多工具步数（3~12）
AGENT_MAX_STEPS=8

# 回答逐行输出的目标总时长（秒）；0=一次性输出，默认 8 秒
ANSWER_STREAM_SECONDS=8

# 仅 mock 演示使用；留空使用系统当天
# DEMO_TODAY=2026-11-18
